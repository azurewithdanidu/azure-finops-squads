{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://finops-squad.local/schemas/spend.schema.json",
  "title": "Spend",
  "description": "Discovery's spend.json. Every field is optional so legacy and 'unavailable' files stay valid; the optional `daily` block adds a daily time series (see .github/skills/cost-query-patterns/SKILL.md). Currency is whatever the Cost Management API returned and is never converted.",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["available", "unavailable"] },
    "reason": { "type": "string" },
    "capturedAt": { "type": "string" },
    "subscriptionId": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "currencyNote": { "type": "string" },
    "timeframe": { "type": "string" },
    "granularity": { "type": "string" },
    "groupBy": { "type": "string" },
    "metric": { "type": "string" },
    "from": { "$ref": "#/definitions/isoDate" },
    "to": { "$ref": "#/definitions/isoDate" },
    "source": { "type": "object" },
    "totalLastMonth": { "type": "number" },
    "byService": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service"],
        "properties": {
          "service": { "type": "string" },
          "cost": { "type": "number" },
          "months": { "type": "object" },
          "note": { "type": "string" }
        }
      }
    },
    "byResourceGroupTop10": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceGroup", "cost"],
        "properties": {
          "resourceGroup": { "type": "string" },
          "cost": { "type": "number" }
        }
      }
    },
    "daily": {
      "type": "object",
      "description": "Daily cost series for the same window as the aggregates: the top 10 services plus an 'Other' row per day, and the all-services total per day.",
      "required": ["from", "to", "series", "dailyTotal"],
      "properties": {
        "granularity": { "type": "string", "enum": ["Daily"] },
        "groupBy": { "type": "string" },
        "metric": { "type": "string" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "from": { "$ref": "#/definitions/isoDate" },
        "to": { "$ref": "#/definitions/isoDate" },
        "provisionalFrom": {
          "$ref": "#/definitions/isoDate",
          "description": "First day of the last 3 days of the window; Cost Management data for these days is still settling."
        },
        "truncated": {
          "type": "boolean",
          "description": "True if the query hit its row limit, so the series may be incomplete."
        },
        "reconciliation": {
          "type": "object",
          "properties": {
            "dailyTotalSum": { "type": "number" },
            "aggregateTotal": { "type": "number" },
            "deltaPct": { "type": "number" }
          }
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "service", "cost"],
            "properties": {
              "date": { "$ref": "#/definitions/isoDate" },
              "service": { "type": "string", "minLength": 1 },
              "cost": { "type": "number" }
            }
          }
        },
        "dailyTotal": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "cost"],
            "properties": {
              "date": { "$ref": "#/definitions/isoDate" },
              "cost": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
