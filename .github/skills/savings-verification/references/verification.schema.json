{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/finops-squad/schemas/verification.schema.json",
  "title": "FinOps Squad Verification",
  "description": "Result of verifying a merged finding against later cost data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findingId",
    "mergedAt",
    "checkedAt",
    "baselineMonthly",
    "observedMonthly",
    "realisedSaving",
    "result"
  ],
  "properties": {
    "findingId": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9]{4}$"
    },
    "mergedAt": {
      "type": "string",
      "format": "date"
    },
    "checkedAt": {
      "type": "string",
      "format": "date"
    },
    "baselineMonthly": {
      "type": "number",
      "minimum": 0
    },
    "observedMonthly": {
      "type": "number",
      "minimum": 0
    },
    "realisedSaving": {
      "type": "number"
    },
    "result": {
      "type": "string",
      "enum": ["confirmed", "partial", "not-observed", "inconclusive"],
      "description": "'inconclusive' when cost data is too fresh to trust."
    },
    "notes": {
      "type": "string"
    }
  }
}
